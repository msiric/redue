{
  "name": "@redue/cli",
  "private": false,
  "version": "0.1.0-alpha.6",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "bin": {
    "redue": "./bin/redue.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:package": "node test/acceptance/package-smoke.mjs",
    "demo": "node test/acceptance/package-smoke.mjs --demo"
  },
  "dependencies": {
    "@parcel/watcher": "2.5.6",
    "picomatch": "2.3.2",
    "yaml": "2.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "description": "Persistent verification state for developers and coding agents.",
  "homepage": "https://github.com/msiric/redue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msiric/redue.git"
  },
  "bugs": {
    "url": "https://github.com/msiric/redue/issues"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "docs/user/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "Apache-2.0"
}
